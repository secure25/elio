# ── LLM (pick one provider and set LLM_PROVIDER) ─────────────────────────
# LLM_PROVIDER must name a provider you have credentials for below. Leave it
# unset to use the first configured provider in the fallback order. A provider
# that reports a quota/balance error cascades to the next configured one, so
# several keys = resilience.
# LLM_PROVIDER=gemini
# Google AI Studio (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model with a generous free tier + strong tool calling
GEMINI_MODEL=gemini-flash-latest

# ── Optional backup providers (OpenAI-compatible endpoints, free tiers) ──
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# OpenRouter free models: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Clean APIs: https://cleanapis.com/docs
CLEANAPIS_API_KEY=
# Cheapest model with both tools and web_search: kimi-k2.6 ($1.22/1M, 1M context)
# Alternative: gemini-3.7-flash ($1.24/1M, 1M context)
CLEANAPIS_MODEL=kimi-k2.6

# ── Gateway providers (base URL + key from your account) ──
# AgentRouter: paste the base URL it gives you (must end in /v1). It serves models
# ONLY through the OpenAI *Responses* API (/v1/responses) and rejects unrecognised
# HTTP clients with 401 "unauthorized client detected", so the adapter sends a
# Claude-CLI-style User-Agent (override with AGENTROUTER_USER_AGENT if yours differs).
AGENTROUTER_API_KEY=
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
# Must be a model your account can reach — check GET /v1/models on the same host.
AGENTROUTER_MODEL=gpt-5.6-sol
# APInex: https://apinex.bond/developers/models/connect (keys start sk-apx…)
APINEX_API_KEY=
# APINEX_BASE_URL=https://api.apinex.bond/v1
APINEX_MODEL=claude-sonnet-4-5

# ── Qwen (temporary/self-hosted OpenAI-compatible endpoint, e.g. Kaggle + tunnel) ──
# Any OpenAI-compatible base URL. The URL changes whenever the tunnel restarts.
QWEN_API_TOKEN=
QWEN_BASE_URL=
QWEN_MODEL=Qwen/Qwen3-8B

# ── Voice (optional) ───────────────────────────────────────────────────
# TTS_PROVIDER controls where spoken text is synthesized (default: auto):
#   auto = prefer ElevenLabs cloud when a key is set, fall back to local Piper/SAPI.
#   local = fully offline: Piper/SAPI only, spoken text NEVER leaves this machine.
# You can also switch engines live in the app: Settings → Behavior → Speech Engine
# (that choice is stored in the DB and overrides this env var).
# TTS_PROVIDER=auto
#
# Server TTS engine chain: (auto mode) ElevenLabs → Piper → Windows SAPI.
# Local chain (local mode): Piper → Windows SAPI. STT is always the browser's
# built-in Web Speech API (nothing is uploaded to this app either way).
#
# ElevenLabs Speech Engine (https://elevenlabs.io → Profile → API Keys):
# ELEVENLABS_API_KEY=
# Voice to use (default: Roger — male, verified working on the FREE plan).
# On the free plan, use the premade voices already in your account or one you
# create in your Voice Lab. Voice Library voices (e.g. "Rachel") are PAID-only
# via the API — they return 402 paid_plan_required.
# ELEVENLABS_VOICE_ID=CwhRBWXzGAHq8TQ4Fs17
# Model: eleven_multilingual_v2 (default) | eleven_turbo_v2_5 | eleven_flash_v2_5
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
#
# Local engine: one-time setup: npm run setup:voice
# (installs Piper + the male en_US-ryan-medium model ~63 MB; pick another with
#  VOICE_MODEL=en_US-joe-medium npm run setup:voice)
# Override auto-detected Piper binary / voice model if you already have them:
# PIPER_BIN=C:\tools\piper\piper.exe
# PIPER_VOICE=C:\tools\piper\en_US-ryan-medium.onnx
# PIPER_PYTHON=python

# ── Vault encryption ─────────────────────────────────────────────────────
# Any long random string. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VAULT_SECRET=

# ── App ──────────────────────────────────────────────────────────────────
ELIO_DATA_DIR=./data
NEXT_PUBLIC_APP_URL=http://localhost:3210

# ── MoltMoney financial tools (Phase 1: read-only; optional) ───────────
# Authenticated agent-banking API. All three values are required for the
# read-only tools (moltmoney_get_account / get_balance / get_transactions)
# to register. Never exposed to the browser — server-side only.
# MOLTMONEY_API_URL=https://<moltmoney-host>
# MOLTMONEY_API_KEY=mm_…            # agent-scoped bearer token
# MOLTMONEY_ACCOUNT_ID=<uuid>       # the AGENT account (keys are account-scoped)
# Kill switch: MOLTMONEY_ENABLED=false unregisters all MoltMoney tools.
# Phase 2 (moltmoney_pay, money movement) will additionally require
# MOLTMONEY_ENABLED=true explicitly and Sentinel human approval.
# MOLTMONEY_ENABLED=

# ── Phone messaging (optional, free, hosted APIs) ────────────────────────
# Telegram: free forever. Supports full 2-way chat with Elio!
# 1) Message @BotFather → /newbot → copy the token here.
# 2) In the app: Connectors → Telegram → Find my chat & connect (send your bot
#    any message first). Recipient is stored encrypted in the vault.
# 3) When deployed on Railway, 2-way chat is enabled automatically via webhook,
#    or click "Enable 2-Way Chat" on the Connectors page.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
#
# ── Web research (optional, server-side only) ────────────────────────────
# Exa (exa.ai) powers web_search with higher-quality results + highlights.
# Get a free key at dashboard.exa.ai. Without it, search falls back to the
# sandboxed-browser DuckDuckGo scrape. Never exposed to the client.
# EXA_API_KEY=
#
# WhatsApp Cloud API (Meta-hosted, free tier for service conversations):
# business.thirdparty setup → add token + phone number id here, then in the app:
# Connectors → WhatsApp → enter the number Elio should message → connect.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
